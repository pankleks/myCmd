{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myCmd", "version": "0.1.0", "identifier": "com.mycmd.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "myCmd", "width": 1200, "height": 700, "minWidth": 900, "minHeight": 500 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": "all" }
}
